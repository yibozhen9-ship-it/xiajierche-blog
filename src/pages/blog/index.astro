---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="文章" description="虾基尔车的全部文章。">
	<div class="shell">
		<section class="page-intro"><span class="eyebrow">文章</span><h1>文章</h1></section>
		<div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div>
	</div>
</BaseLayout>
