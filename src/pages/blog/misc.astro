---
import { getCollection } from 'astro:content';
import PostCard from '../../components/PostCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.category === '杂七杂八')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title="杂七杂八" description="虾基尔车的杂七杂八。">
	<div class="shell">
		<section class="page-intro"><span class="eyebrow">分类</span><h1>杂七杂八</h1></section>
		<nav class="category-links" aria-label="文章分类"><a href="/blog/daily/">日常</a><a aria-current="page" href="/blog/misc/">杂七杂八</a></nav>
		{posts.length ? <div class="post-list">{posts.map((post) => <PostCard post={post} />)}</div> : <p class="empty-state">这里还没有文章。</p>}
	</div>
</BaseLayout>
