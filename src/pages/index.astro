---
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import { site } from '../lib/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = posts;
---

<BaseLayout>
	<div class="shell">
		<section class="page-intro">
			<span class="eyebrow">个人博客</span>
			<h1>{site.title}</h1>
			<p>{site.description}</p>
		</section>
		{featured && <PostCard post={featured} featured />}
		{rest.length > 0 && (
			<section aria-labelledby="latest-title">
				<div class="section-heading"><h2 id="latest-title">最近更新</h2><a href="/blog/">查看全部文章 →</a></div>
				<div class="post-list">{rest.map((post) => <PostCard post={post} />)}</div>
			</section>
		)}
	</div>
</BaseLayout>
