---
import { site } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} · ${site.title}` : site.title;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/rss+xml" title={`${site.title} RSS`} href="/rss.xml" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="shell nav-wrap">
				<a class="brand" href="/" aria-label={`${site.title} 首页`}>
					<span class="brand-mark">虾</span>
					<span>{site.title}</span>
				</a>
				<nav aria-label="主导航">
					<a href="/">首页</a>
					<a href="/blog/">文章</a>
					<a href="/about/">关于</a>
				</nav>
			</div>
		</header>
		<main><slot /></main>
		<footer class="site-footer">
			<div class="shell footer-wrap">
				<p>© {new Date().getFullYear()} {site.title}</p>
				<a href="/rss.xml">RSS</a>
			</div>
		</footer>
	</body>
</html>

<style is:global>
	:root { --paper:#f7f5f0; --paper-deep:#efeae1; --ink:#24231f; --muted:#706d64; --line:#ded9ce; --accent:#9a4b30; --accent-soft:#f2ded2; --serif:"Iowan Old Style","Songti SC","Noto Serif CJK SC","STSong",serif; --sans:"Avenir Next","PingFang SC","Noto Sans CJK SC",sans-serif; }
	* { box-sizing:border-box; }
	html { background:var(--paper); color:var(--ink); scroll-behavior:smooth; }
	body { margin:0; font-family:var(--sans); line-height:1.7; }
	a { color:inherit; text-decoration-color:color-mix(in srgb,currentColor 35%,transparent); text-underline-offset:.2em; }
	a:hover { color:var(--accent); }
	.shell { width:min(1120px,calc(100% - 48px)); margin:0 auto; }
	.site-header { border-bottom:1px solid var(--line); }
	.nav-wrap { min-height:76px; display:flex; align-items:center; justify-content:space-between; gap:24px; }
	.brand { display:inline-flex; align-items:center; gap:10px; font-family:var(--serif); font-size:1.35rem; font-weight:700; text-decoration:none; }
	.brand-mark { width:31px; height:31px; display:grid; place-items:center; border-radius:50%; background:var(--ink); color:var(--paper); font-family:Georgia,serif; font-size:.9rem; }
	nav { display:flex; gap:22px; font-size:.94rem; }
	nav a { text-decoration:none; color:var(--muted); }
	.site-footer { border-top:1px solid var(--line); margin-top:96px; color:var(--muted); font-size:.88rem; }
	.footer-wrap { min-height:90px; display:flex; align-items:center; justify-content:space-between; gap:16px; }
	.eyebrow { display:flex; align-items:center; gap:9px; color:var(--accent); font-size:.78rem; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
	.eyebrow::before { content:''; width:22px; height:1px; background:currentColor; }
	.page-intro { max-width:690px; padding:76px 0 44px; }
	.page-intro h1 { margin:12px 0 16px; font-family:var(--serif); font-size:clamp(2.7rem,7vw,5.4rem); font-weight:600; line-height:1.06; letter-spacing:-.045em; }
	.page-intro p { max-width:560px; margin:0; color:var(--muted); font-size:1.08rem; }
	.section-heading { display:flex; align-items:baseline; justify-content:space-between; gap:20px; margin:40px 0 20px; }
	.section-heading h2 { margin:0; font-family:var(--serif); font-size:1.55rem; }
	.section-heading a, .section-heading span { color:var(--muted); font-size:.88rem; }
	.post-list { border-top:1px solid var(--line); }
	.post-card { display:grid; grid-template-columns:136px 1fr auto; gap:24px; align-items:start; padding:28px 0; border-bottom:1px solid var(--line); text-decoration:none; transition:padding 160ms ease,background 160ms ease; }
	.post-card:hover { color:var(--ink); padding-inline:12px; background:rgba(255,255,255,.45); }
	.post-date { margin:0; color:var(--muted); font-size:.88rem; white-space:nowrap; }
	.post-card h2 { margin:-.12em 0 7px; font-family:var(--serif); font-size:clamp(1.35rem,3vw,1.8rem); font-weight:600; line-height:1.25; }
	.post-card p { margin:0; color:var(--muted); font-size:.95rem; }
	.tags { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:7px; }
	.tag { padding:3px 9px; border-radius:100px; background:var(--paper-deep); color:var(--muted); font-size:.76rem; white-space:nowrap; }
	.featured { display:grid; grid-template-columns:1.3fr .7fr; gap:24px; margin-top:34px; padding:36px; border-radius:4px; background:var(--ink); color:var(--paper); text-decoration:none; }
	.featured:hover { color:var(--paper); }
	.featured .post-date, .featured p { color:#d5cfc4; }
	.featured h2 { margin:12px 0; font-family:var(--serif); font-size:clamp(2rem,4vw,3.5rem); font-weight:500; line-height:1.12; }
	.featured .tags { justify-content:flex-start; align-self:end; }
	.featured .tag { background:#414039; color:#e7e1d7; }
	.prose { width:min(720px,calc(100% - 48px)); margin:0 auto; }
	.article-header { padding:78px 0 42px; border-bottom:1px solid var(--line); }
	.article-header h1 { margin:16px 0 18px; font-family:var(--serif); font-size:clamp(2.7rem,6vw,4.8rem); font-weight:600; line-height:1.1; letter-spacing:-.04em; }
	.article-header > p { margin:0; color:var(--muted); font-size:1.08rem; }
	.article-meta { display:flex; flex-wrap:wrap; gap:14px; margin-top:28px; color:var(--muted); font-size:.86rem; }
	.article-body { padding-top:36px; font-size:1.08rem; }
	.article-body h2 { margin:2.4em 0 .7em; font-family:var(--serif); font-size:1.8rem; line-height:1.3; }
	.article-body h3 { margin:2em 0 .6em; font-size:1.1rem; }
	.article-body p, .article-body li { max-width:68ch; }
	.article-body a { color:var(--accent); }
	.article-body blockquote { margin:1.8em 0; padding:6px 0 6px 24px; border-left:2px solid var(--accent); color:var(--muted); font-family:var(--serif); font-size:1.2rem; }
	.article-body code { padding:.15em .35em; border-radius:4px; background:var(--paper-deep); font-size:.88em; }
	.article-body img { display:block; max-width:100%; height:auto; margin:2em 0; border-radius:4px; }
	.category-links { display:flex; flex-wrap:wrap; gap:10px; margin:-12px 0 28px; }
	.category-links a { padding:6px 12px; border:1px solid var(--line); border-radius:100px; color:var(--muted); font-size:.88rem; text-decoration:none; }
	.category-links a[aria-current="page"], .category-links a:hover { border-color:var(--accent); color:var(--accent); }
	.empty-state { margin:0; padding:26px 0; color:var(--muted); border-top:1px solid var(--line); border-bottom:1px solid var(--line); }
	.contact { margin-top:18px !important; font-size:.98rem !important; }
	.about-grid { display:grid; grid-template-columns:minmax(0,1fr) 260px; gap:72px; padding-top:18px; }
	.about-grid h2 { margin:0 0 12px; font-family:var(--serif); font-size:2rem; font-weight:600; }
	.about-grid p { color:var(--muted); font-size:1.04rem; }
	.note { padding:26px; background:var(--accent-soft); }
	.note h3 { margin:0 0 12px; font-family:var(--serif); font-size:1.25rem; }
	.note p { margin:0; color:#6f3826; font-size:.93rem; }
	@media (max-width:680px) { .shell{width:min(100% - 32px,1120px)} .nav-wrap{min-height:66px} nav{gap:14px;font-size:.88rem} .page-intro{padding-top:52px} .featured{grid-template-columns:1fr;padding:26px} .post-card{grid-template-columns:1fr;gap:8px} .post-date{order:2} .tags{justify-content:flex-start;order:3} .article-header{padding-top:52px} .about-grid{grid-template-columns:1fr;gap:36px} .site-footer{margin-top:64px} .footer-wrap{align-items:flex-start;flex-direction:column;justify-content:center} }
</style>
